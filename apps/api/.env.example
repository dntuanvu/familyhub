DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familyhub?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
WEB_BASE_URL="http://localhost:5173"

# --- Email delivery (password reset) ---
# Leave empty to log emails to the server console (dev default).
# Supported: "resend" | "postmark" (or omit and set one of the keys below).
MAIL_PROVIDER=""
MAIL_FROM="Family Hub <onboarding@resend.dev>"

# Resend (https://resend.com) — simplest; onboarding@resend.dev works without
# domain verification but only sends to the Resend account owner's email.
RESEND_API_KEY=""

# Postmark (https://postmarkapp.com) — requires a verified sender signature.
POSTMARK_SERVER_TOKEN=""
POSTMARK_STREAM="outbound"

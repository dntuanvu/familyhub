{
  "name": "family-hub",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:api": "pnpm --filter @family-hub/api dev",
    "dev:web": "pnpm --filter @family-hub/web dev",
    "dev:mobile": "pnpm --filter @family-hub/mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prisma:generate": "pnpm --filter @family-hub/api prisma:generate",
    "prisma:migrate": "pnpm --filter @family-hub/api prisma:migrate",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:down": "docker compose -f docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
